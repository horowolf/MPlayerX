# MPlayerX MPX_*_IDS hooks for MPlayer 1.5
#
# The arm64 mplayer bundled with this fork is built from pristine MPlayer 1.5
# (build-mplayer/MPlayer-1.5, which is NOT under version control), while the
# original MPlayerX shipped a patched MPlayer 1.0rc-era tree -- kept here as
# the tracked mplayer/ directory. Five of the patch's MPX_* output hooks were
# never carried over. Without MPX_AUDIO_IDS/MPX_VIDEO_IDS the app never learns
# that a file has video tracks, so it treats every movie as audio-only: the
# window collapses to contentMinSize on the next/previous-episode switch, the
# Inspector's Track Info and Format stay blank, and the Switch Audio/Switch
# Video submenus come up empty.
#
# Apply from build-mplayer/MPlayer-1.5 with:  patch -p1 < this-file
# Still missing (bigger patches, not ported yet): MPX_MPXSUBNAMES and
# MPX_MPXSUBFILEADD (subtitle track listing, needs the mpx_subid option) and
# MPX_CHAPTERINFO (stream/stream_dvd.c, DVD/VIDEO_TS only).

--- a/libmpdemux/stheader.h	2026-08-23 00:35:11
+++ b/libmpdemux/stheader.h	2026-08-23 00:35:31
@@ -42,6 +42,7 @@
   /* codec-specific: */ \
   void* context;   /* codec-specific stuff (usually HANDLE or struct pointer) */ \
   char* lang; /* track language */ \
+  char* name; /* track title, used by MPlayerX's MPX_*_IDS output */ \
   int default_track; \
 
 typedef struct sh_common {
